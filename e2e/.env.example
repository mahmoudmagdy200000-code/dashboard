# Copy to .env.local (git-ignored) or export in your shell. NEVER commit real values.
# Mode: unit | preflight | isolated | staging-financial
ASSAB_E2E_MODE=preflight
# Backend origin WITHOUT /api/v1
ASSAB_E2E_API_ORIGIN=
# Deployed dashboard (Vercel) URL — optional; enables UI steps when ASSAB_E2E_UI=true
ASSAB_E2E_FRONTEND_URL=
ASSAB_E2E_UI=true
# Synthetic fixture (defaults shown)
ASSAB_E2E_NAMESPACE=assab-ui-qa-20261018
ASSAB_E2E_COMPANY_ID=fbfae45c-5ad7-5511-8e94-1c93b3bea4ca
ASSAB_E2E_BRANCH_ID=d47212bb-2ffd-55a6-98e5-92609d000238
# Single runtime fixture password — supply from a secret store / CI secret only
ASSAB_E2E_FIXTURE_PASSWORD=
# Deployment identity (operator-attested; no backend endpoint exposes it)
ASSAB_E2E_EXPECTED_BACKEND_SHA=
ASSAB_E2E_ATTESTED_DEPLOYED_BACKEND_SHA=
ASSAB_E2E_EXPECTED_FRONTEND_SHA=
ASSAB_E2E_ATTESTED_DEPLOYED_FRONTEND_SHA=
# Mode C only
ASSAB_E2E_ALLOWED_API_HOSTS=
# Exact phrase: MUTATE_ASSAB_STAGING_FINANCIAL_FIXTURE:<namespace>:<YYYY-MM-DD Asia/Riyadh>
ASSAB_E2E_FINANCIAL_ACK=
# Optional overrides
ASSAB_E2E_BUSINESS_DATE=
ASSAB_E2E_OPENING_SCENARIO=zero
